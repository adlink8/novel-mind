# =============================================================================
# NovelMind 环境变量模板
# =============================================================================
# 使用方法: 复制本文件为 .env，然后填入实际值
#   cp .env.example .env
# 注意: .env 文件已被 .gitignore 排除，不会提交到版本控制
# =============================================================================

# --- 数据库连接 ---
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# asyncpg 为异步驱动，实现高性能并发数据库操作
# Docker 环境下主机名使用服务名 'db'，本地开发使用 'localhost'
NOVELMIND_DATABASE_URL=postgresql+asyncpg://novelmind:novelmind@localhost:5432/novelmind

# Generate two different random values with at least 32 characters for production.
NOVELMIND_SECRET_KEY=replace-with-unique-jwt-secret-at-least-32-chars
NOVELMIND_ENCRYPTION_KEY=replace-with-unique-data-key-at-least-32-chars
NOVELMIND_PREVIOUS_ENCRYPTION_KEYS=
NOVELMIND_AUTH_COOKIE_SECURE=false

# 引导管理员一次性 token（生产必配，防公开抢注 superuser）。
# 首个注册用户必须携带匹配的 bootstrap_token 才能成为管理员，此后自动关闭。
# 未配置时生产模式（debug=false）注册接口 fail-closed；本地开发（debug=true）可留空。
NOVELMIND_BOOTSTRAP_ADMIN_TOKEN=

# Comma-separated exact hosts. Private hosts must also be listed separately.
NOVELMIND_AI_ALLOWED_HOSTS=api.openai.com,api.anthropic.com
NOVELMIND_AI_ALLOWED_PRIVATE_HOSTS=

# --- AI 模型 API 密钥 ---
# OpenAI API 密钥（用于 GPT 系列模型，如 GPT-4o）
# 获取地址: https://platform.openai.com/api-keys
NOVELMIND_OPENAI_API_KEY=sk-you...-key

# OpenAI API 基础 URL（默认官方地址；兼容 API 可修改为第三方地址）
# 也可用于指向 OpenAI 兼容的本地代理服务
NOVELMIND_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API 密钥（用于 Claude 系列模型）
# 获取地址: https://console.anthropic.com/
NOVELMIND_ANTHROPIC_API_KEY=sk-ant...-key

# Google Gemini API 密钥（AI Studio 免费额度）
# 获取地址: https://aistudio.google.com/apikey
NOVELMIND_GEMINI_API_KEY=
# 默认聊天模型（LiteLLM 标识）
NOVELMIND_DEFAULT_CHAT_MODEL=gemini/gemini-2.5-flash

# Ollama 本地模型服务地址（用于本地部署的开源模型，如 Llama、Qwen 等）
# 需要先启动 Ollama 服务: ollama serve
NOVELMIND_OLLAMA_BASE_URL=http://localhost:11434

# --- 应用配置 ---
# 调试模式开关（true: 显示详细错误信息和热重载；生产环境设为 false）
NOVELMIND_DEBUG=true

# Cookie CSRF allowlist (JSON array). Must include the browser Origin of the frontend.
# When Next.js runs on a non-default port (e.g. 3005), add that origin here.
NOVELMIND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004","http://localhost:3005","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:3002","http://127.0.0.1:3003","http://127.0.0.1:3004","http://127.0.0.1:3005"]

# 文件上传目录（相对路径或绝对路径，存储用户上传的小说文档）
NOVELMIND_UPLOAD_DIR=./uploads

# 最大上传文件大小（单位: 字节，默认 50MB = 52428800）
# 超过此大小的文件上传将被拒绝
NOVELMIND_MAX_UPLOAD_SIZE=52428800

# --- Embedding 模型配置（默认与「数据分析」一致：本地 BGE）---
# local_st | ollama | openai
NOVELMIND_EMBEDDING_PROVIDER=local_st
NOVELMIND_EMBEDDING_MODEL=bge-small-zh-v1.5
NOVELMIND_EMBEDDING_MODEL_PATH=D:\models\bge-small-zh-v1.5
NOVELMIND_EMBEDDING_DIMENSIONS=512
# cuda（有 GPU + CUDA 版 torch 时）或 cpu（无 CUDA 时会自动回退）
NOVELMIND_EMBEDDING_DEVICE=cpu
NOVELMIND_EMBEDDING_BATCH_SIZE=64

# --- Google Cloud Vertex AI（与「数据分析」一致，聊天默认）---
# 认证: gcloud auth login（不用 AI Studio AIza key）
NOVELMIND_CHAT_PROVIDER=vertex_google
NOVELMIND_DEFAULT_CHAT_MODEL=vertex_google/gemini-3.5-flash
NOVELMIND_GCP_PROJECT=project-c5cbd608-1b00-454e-80f
NOVELMIND_GCP_LOCATION=us-central1
NOVELMIND_GCP_SDK_ROOT=C:\Users\li\google-cloud-sdk
NOVELMIND_GCP_SDK_PY=C:\Users\li\google-cloud-sdk\lib\gcloud.py
NOVELMIND_VERTEX_MODEL=gemini-3.5-flash
