# =============================================================================
# NovelMind .gitignore
# =============================================================================

# --- Python & Node.js 依赖目录 ---
node_modules/
__pycache__/
*.pyc
.venv*/
venv/

# --- 构建产物 ---
.next/
dist/
build/
*.egg-info/

# --- 环境变量（含敏感信息，绝不提交）---
.env
.env.local
.env.*.local

# --- IDE 配置 ---
.vscode/
.idea/
*.swp
*.swo

# --- 用户上传文件 ---
uploads/
*.tmp

# --- 本地数据库文件 ---
*.db
*.sqlite3

# --- 日志文件 ---
*.log

# --- 操作系统生成文件 ---
.DS_Store
Thumbs.db

# --- 测试与临时文件 ---
test_*.txt
.test-tmp*/
nul
tsconfig.tsbuildinfo

# --- 治理测试进程级转译产物（governance.test.ts 生成，勿提交）---
agent-service/tests/fixtures/.gov-tmp/
agent-service/tests/fixtures/.tmp-gov-*

# --- 后端上传的测试数据 ---
backend/uploads/
# 插图资产运行时存储（生图产物，非源码）
backend/storage/
test_novel.txt

# --- Local agent state and imported novel sources ---
.workbuddy/
.gsd/
/*.txt

# --- Test/CI local artifacts (do not commit) ---
.coverage
coverage/
htmlcov/
backend/artifacts/**
!backend/artifacts/.gitkeep
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
*.xml
!**/coverage-policy.schema.json
!**/openapi-baseline.json

# local one-off scripts
backend/_up*.py

# --- 运行时 PID 文件（本地进程保活产物，不提交）---
*.pid

# --- 本地数据库备份 dump（体积大，不进版本库，保留本地）---
backups/*.dump

# --- git 损坏备份与本地环境目录（不提交）---
.git-corrupt-*/
.claude/
.playwright-cli/

